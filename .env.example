# Copiar a .env.local para desarrollo y cargar en Vercel > Settings > Environment Variables.

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX). Sin valor, no se carga ningún script de medición.
NEXT_PUBLIC_GA_ID=

# Código de verificación de Google Search Console (solo el valor de content="...").
GOOGLE_SITE_VERIFICATION=
